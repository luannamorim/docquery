# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
# Required: shared secret between the app and the Qdrant server
# (wired to QDRANT__SERVICE__API_KEY in docker-compose). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=your-qdrant-api-key-here

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# Retrieval
RETRIEVAL_TOP_K=20

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# LLM
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Ingestion
# INGEST_ROOT: folder ingested recursively. Default "docs" works for the demo;
# for the real (confidential) corpus use the gitignored "data" folder.
INGEST_ROOT=docs

# Folder facets need no configuration: every folder under INGEST_ROOT becomes a
# search filter on its own, at any depth (see docs/TAXONOMY.md).

# --- Clearance (server-side access levels) ------------------------------------
# Access level is NOT derived from folder names — anyone who can rename a folder
# would otherwise change who may read it. Grant it explicitly by path prefix;
# first match wins, everything else gets DEFAULT_CLEARANCE_LEVEL.
# KEEP THE TRAILING SEPARATOR: the prefix "data/rh/restrito" (no slash) would
# also capture a sibling folder named "restrito-publico".
DEFAULT_CLEARANCE_LEVEL=0
MAX_CLEARANCE_LEVEL=10
CLEARANCE_POLICY='[["data/rh/restrito/", 5]]'

# --- Auth (Azure Entra ID) ---------------------------------------------------
# Off by default so the quickstart runs without a tenant; required in production.
# Setting AUTH_ENABLED=true without a tenant and client id fails at startup.
AUTH_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# App role -> clearance level. Highest matching role wins, capped at
# MAX_CLEARANCE_LEVEL; a token with no mapped role gets DEFAULT_CLEARANCE_LEVEL.
AUTH_ROLE_CLEARANCE_MAP='[["clearance.5", 5], ["clearance.10", 10]]'
# Clock-skew tolerance for exp/nbf/iat.
AUTH_LEEWAY_SECONDS=60

# --- Remote ingest sources ---------------------------------------------------
# Which remote URIs POST /ingest may pull. Empty accepts none (fail-closed);
# the CLI is unrestricted. Matched on path boundaries.
INGEST_ALLOWED_SOURCE_PREFIXES='[]'
SOURCE_MAX_FILE_MB=50

# SharePoint via Microsoft Graph (client credentials). This is a DIFFERENT app
# registration from AZURE_CLIENT_ID above: that one identifies this API as a
# token audience, this one reads documents. Needs Sites.Read.All (or
# Sites.Selected with a per-site grant).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Google Drive service account key, as a path to the mounted JSON file. Share
# the Drive folders with the service account's e-mail address.
GDRIVE_SERVICE_ACCOUNT_FILE=
