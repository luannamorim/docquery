# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
# Required: shared secret between the app and the Qdrant server
# (wired to QDRANT__SERVICE__API_KEY in docker-compose). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=your-qdrant-api-key-here

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# Retrieval
RETRIEVAL_TOP_K=20

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# LLM
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Cost accounting, per million tokens. Only used to fill cost_usd on each turn —
# wrong values silently produce wrong numbers, so update them with the model.
LLM_PRICE_INPUT_PER_1M=0.15
LLM_PRICE_OUTPUT_PER_1M=0.60

# Ingestion
# INGEST_ROOT: folder ingested recursively. Default "docs" works for the demo;
# for the real (confidential) corpus use the gitignored "data" folder.
INGEST_ROOT=docs

# --- Document parsing (Docling) ----------------------------------------------
# Off by default: the legacy parsers are enough for markdown and text-layer
# PDFs, and Docling is CPU-heavy. Turn it ON for any corpus with scanned
# documents — without it a scanned PDF yields no text, is indexed as nothing,
# and retrieval then answers questions about it with a confident "no such
# document". Ingest warns when that happens.
# Applies to .pdf .docx .pptx .xlsx and images; .md and .txt never use it.
DOCLING_ENABLED=false
# OCR runs only over bitmap regions, so a text-layer PDF pays nothing for it.
DOCLING_OCR_ENABLED=true
# TableFormer structure recovery — the expensive part. Worth it for contracts
# and anything where a table carries the answer.
DOCLING_TABLE_STRUCTURE=true
# A file above this fails rather than falling back to the legacy parser: a
# configured limit is policy, and degrading quietly would ingest exactly the
# document the limit exists to keep out.
DOCLING_MAX_FILE_MB=50

# Folder facets need no configuration: every folder under INGEST_ROOT becomes a
# search filter on its own, at any depth. The top-level folder is also the
# document's access compartment (its "sector") — see docs/TAXONOMY.md.

# --- Auth (Azure Entra ID) ---------------------------------------------------
# Off by default so the quickstart runs without a tenant; required in production.
# Setting AUTH_ENABLED=true without a tenant and client id fails at startup.
AUTH_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Clock-skew tolerance for exp/nbf/iat.
AUTH_LEEWAY_SECONDS=60

# App role -> sector, only for folder names an Entra role value cannot spell
# (it takes no spaces or accents). A role named sector.<folder> already grants
# that folder by convention, so most deployments leave this empty.
# AUTH_ROLE_SECTOR_MAP='[["sector.rh","recursos humanos"]]'

# --- Browser client ----------------------------------------------------------
# The SPA's own Entra registration (type: Single-page application), separate
# from AZURE_CLIENT_ID: that one is the API's audience, this one obtains tokens
# for it. Its redirect URI is the app's own origin. Public by definition — a
# browser client has no secret.
FRONTEND_CLIENT_ID=

# What the interface calls this deployment: sidebar, sign-in screen, tab title.
# Rendered exactly as written, capitals included.
APP_NAME=docquery

# --- Answers -----------------------------------------------------------------
# Empty: the model replies in the language of the question, which is right when
# an English contract is read by Portuguese speakers. Set it (e.g. pt-BR) to fix
# the language regardless — it also translates the three refusals that never
# reach the model ("no documents matched", and friends).
ANSWER_LANGUAGE=

# INFO by default because the access decisions are logged at that level
# ("Query authorized for sectors=..."), and uvicorn would otherwise drop them.
LOG_LEVEL=INFO

# --- Conversation history ----------------------------------------------------
# Multi-turn follow-ups plus an audit trail, in MySQL. Requires AUTH_ENABLED:
# a conversation is owned by the token's oid, and without one it has no owner.
# The app refuses to start if this is on and either is missing.
HISTORY_ENABLED=false
HISTORY_DSN=mysql://docquery:change-me@mysql:3306/docquery
# How many earlier questions the follow-up rewrite may see. The rewrite is one
# LLM call whose prompt grows with the conversation, hence a bound.
HISTORY_CONTEXT_TURNS=6

# Used by the mysql service in docker-compose.yml, not by the app. Only applied
# when the volume is first created — changing it later does NOT change the
# password already stored in mysql_data.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=docquery

# --- Rate limit --------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=60
# Behind Docker, a reverse proxy or an ingress every request arrives from the
# same address, so one bucket ends up covering everybody. Turn this on ONLY
# where a proxy you control sets X-Forwarded-For — the header is caller-supplied,
# and trusting it otherwise lets anyone escape the limit at will.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- Remote ingest sources ---------------------------------------------------
# Which remote URIs POST /ingest may pull. Empty accepts none (fail-closed);
# the CLI is unrestricted. Matched on path boundaries.
INGEST_ALLOWED_SOURCE_PREFIXES='[]'
SOURCE_MAX_FILE_MB=50

# SharePoint via Microsoft Graph (client credentials). This is a DIFFERENT app
# registration from AZURE_CLIENT_ID above: that one identifies this API as a
# token audience, this one reads documents. Needs Sites.Read.All (or
# Sites.Selected with a per-site grant).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Google Drive service account key, as a path to the mounted JSON file. Share
# the Drive folders with the service account's e-mail address.
GDRIVE_SERVICE_ACCOUNT_FILE=
