# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=documents
# Required: shared secret between the app and the Qdrant server
# (wired to QDRANT__SERVICE__API_KEY in docker-compose). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
QDRANT_API_KEY=your-qdrant-api-key-here

# Embedding
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# Retrieval
RETRIEVAL_TOP_K=20

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# LLM
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Ingestion
# INGEST_ROOT: folder ingested recursively. Default "docs" works for the demo;
# for the real (confidential) corpus use the gitignored "data" folder.
INGEST_ROOT=docs

# Document type taxonomy — folder prefix -> doc_type (JSON list of [prefix, type]
# pairs; first matching prefix wins). Prefixes must match INGEST_ROOT
# (e.g. data/contracts when INGEST_ROOT=data).
type_policy=[["docs/contracts","contract"],["docs/policies","policy"],["docs/manuals","manual"]]
