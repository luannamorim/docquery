{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local*)",
      "Read(./.env.dev*)",
      "Read(./.env.hml*)",
      "Read(./.env.homolog*)",
      "Read(./.env.prod*)",
      "Read(./.env.qa*)",
      "Read(./.env.stag*)",
      "Read(./.env.test*)",
      "Read(./.env.secret*)",
      "Read(./.env.bak*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  }
}
