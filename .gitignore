cython_debug/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# Eval datasets — one built from the real corpus carries its file names, party
# names and paths, even when it holds no passage text. Catch-all with a
# carve-out, the same shape the .env block above uses: the three datasets built
# from docs/sample stay tracked, and anything new stays local until someone
# confirms it is not confidential.
eval/dataset*.json
!eval/dataset.json
!eval/dataset_v2.json
!eval/dataset_multiturn.json

# Eval runs — only the curated baseline and milestone snapshots are tracked.
# Ad-hoc `make eval` output lands here and should stay local.
#
# `**/` and not `eval/results/*.json`: that pattern matches direct children
# only, so a comparison run written into its own subdirectory
# (eval/results/document_scope/) escaped it entirely.
eval/results/**/*.json
!eval/results/baseline.json
!eval/results/milestones/*.json
!eval/results/security/*.json

# Claude Code agent runtime memory — written by subagents at run time, goes
# stale fast as the code evolves. The agent definitions themselves live in
# .claude/agents/ and ARE tracked.
.claude/agent-memory/

# Real (confidential) corpus to ingest — contracts, policies, etc. NEVER commit
# private company documents. Set INGEST_ROOT=data; the folders under it become
# search facets on their own. The repo keeps only the example docs under docs/.
/data/

# Frontend — dependencies and the production build. The build lands inside the
# Python package so app.py can mount it with a path relative to itself and so
# it ships in the image without a second copy step; it is generated by the
# Dockerfile's node stage and must not be committed alongside its source.
frontend/node_modules/
src/docquery/api/static/
